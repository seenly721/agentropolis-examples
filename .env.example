# Copy to .env (git-ignored) and fill in. NEVER commit a real private key.

# Your OWN buyer wallet (0x + 64 hex). Needs a little USDC on the chosen network; no ETH needed
# (x402 "exact" payments are EIP-3009 authorizations; the seller's facilitator pays gas).
# Use a dedicated low-balance hot wallet for agents.
BUYER_PRIVATE_KEY=

# Safety cap per payment in USD. The examples refuse any 402 that asks for more.
MAX_PAYMENT_USD=0.05

# eip155:8453 = Base mainnet (real USDC). eip155:84532 = Base Sepolia (testnet USDC).
X402_NETWORK=eip155:8453

# What to search for and which listing to buy (any id from search_kits).
SEARCH_QUERY=token honeypot check on Base
KIT_ID=seenly.seenly-token-preflight
# Optional request body (JSON). Defaults to the kit manifest's sample input.
# KIT_INPUT_JSON={"chain":"base","tokenAddress":"0x4ed4E862860beD51a9570b96d89aF5E1B0Efefed"}

# Optional: call a different endpoint than the manifest's (e.g. your local testnet copy of a kit).
# KIT_ENDPOINT_OVERRIDE=http://localhost:3412/api/token-preflight

AGENTROPOLIS_MCP_URL=https://agentropolis.io/api/mcp

# Only for --agent (LLM loop). Vercel AI SDK accepts AI_GATEWAY_API_KEY or OPENAI_API_KEY (set AI_MODEL to taste).
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=
# AI_MODEL=openai/gpt-5-mini
